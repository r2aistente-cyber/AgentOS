{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R2 Autonomous",
  "version": "1.0.0",
  "identifier": "ai.r2autonomous.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "R2",
        "width": 920,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "R2 Autonomous"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
